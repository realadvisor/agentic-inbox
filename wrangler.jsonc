{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "realadvisor-email-inbox-prototype",
	"account_id": "71c7813809b4adb2fc4766ba1fd5cf2d",
	"main": "server/worker.ts",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"workers_dev": false,
	"routes": [{ "pattern": "inbox.realadvisor.com", "custom_domain": true }],
	"preview_urls": false,
	"assets": {
		"directory": "./build/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	"triggers": { "crons": ["*/15 * * * *"] },
	"ai": { "binding": "AI" },
	"send_email": [{ "name": "EMAIL" }],
	"vars": {
		"MAIL_MODE": "live",
		"CLASSIFIERS_ENABLED": "true",
		"CLOUD_TASKS_PROJECT": "realadvisor-prod",
		"CLOUD_TASKS_LOCATION": "europe-west1",
		"CLOUD_TASKS_SERVICE_ACCOUNT": "inbox-classifications@realadvisor-prod.iam.gserviceaccount.com",
		"MAILBOX_ADMINS": "jonas@realadvisor.com",
		"MAILBOX_CREATION_ENABLED": "true",
		"INBOUND_ENABLED": "true",
		"ACCESS_ISSUER": "https://realadvisor.cloudflareaccess.com",
		"ACCESS_AUDIENCE": "46ebcd3d8228fe0452ef2831b15d748f3f45de65ef84dd85a533a9cc8d543bd1",
		"PUBLIC_ORIGIN": "https://inbox.realadvisor.com",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "042751d6da4a41509d20e7a43f62e27f",
		},
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "realadvisor-email-inbox-prototype",
		},
	],
}
