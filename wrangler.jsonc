{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "realadvisor-email-inbox-prototype",
	"account_id": "71c7813809b4adb2fc4766ba1fd5cf2d",
	"main": "server/worker.ts",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./build/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	"vars": {
		"PUBLIC_ORIGIN": "https://realadvisor-email-inbox-prototype.rodriguezjoan.workers.dev",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "042751d6da4a41509d20e7a43f62e27f",
		},
	],
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "realadvisor-email-inbox-prototype",
		},
	],
}
